# Security settings
SECRET_KEY=django-insecure-sample-key-change-in-production-vynzora-2025
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*.onrender.com,*.railway.app

# Database settings
# Default is SQLite for local development (no setup required).
# For PostgreSQL (e.g., Render/Railway/Supabase), uncomment and set DATABASE_URL:
# DATABASE_URL=postgres://user:password@hostname:5432/vehicle_db

# CORS allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
